{
    "entries": [
        {
            "message": "Red light crossed by the vehicle",
            "translations": [
                {
                    "lang": "hi",
                    "text": "लाल बत्ती वाहन द्वारा पार की गई"
                },
                {
                    "lang": "ta",
                    "text": "சிவப்பு விளக்கு வாகனத்தால் கடக்கப்பட்டது"
                },
                {
                    "lang": "te",
                    "text": "రెడ్ లైట్ వాహనం దాటింది"
                },
                {
                    "lang": "ml",
                    "text": "വാഹനം ക്രോസ്ഡ് റെഡ് ലൈറ്റ്"
                },
                {
                    "lang": "gu",
                    "text": "રેડ લાઇટ વાહન દ્વારા ઓળંગી"
                },
                {
                    "lang": "bn",
                    "text": "রেড লাইট যানবাহন দিয়ে অতিক্রম করেছে"
                },
                {
                    "lang": "ur",
                    "text": "ریڈ لائٹ گاڑی کے ذریعہ عبور کی گئی"
                },
                {
                    "lang": "kn",
                    "text": "ಕೆಂಪು ದೀಪವು ವಾಹನದಿಂದ ದಾಟಿದೆ"
                }
            ]
        },
        {
            "message": "Yellow light crossed by the vehicle",
            "translations": [
                {
                    "lang": "hi",
                    "text": "पीला प्रकाश वाहन द्वारा पार किया गया"
                },
                {
                    "lang": "ta",
                    "text": "மஞ்சள் ஒளி வாகனத்தால் கடக்கப்படுகிறது"
                },
                {
                    "lang": "te",
                    "text": "పసుపు కాంతి వాహనం దాటింది"
                },
                {
                    "lang": "ml",
                    "text": "വാഹനം ക്രോസ്ഡ് മഞ്ഞ വെളിച്ചം"
                },
                {
                    "lang": "gu",
                    "text": "વાહન દ્વારા પીળો પ્રકાશ ઓળંગી ગયો"
                },
                {
                    "lang": "bn",
                    "text": "গাড়ির পাশে হলুদ আলো অতিক্রম করেছে"
                },
                {
                    "lang": "ur",
                    "text": "گاڑی کے ذریعہ پیلے رنگ کی روشنی عبور ہوئی"
                },
                {
                    "lang": "kn",
                    "text": "ಹಳದಿ ಬೆಳಕು ವಾಹನದಿಂದ ದಾಟಿದೆ"
                }
            ]
        },
        {
            "message": "Green light crossed by the vehicle",
            "translations": [
                {
                    "lang": "hi",
                    "text": "वाहन द्वारा हरी बत्ती पार की गई"
                },
                {
                    "lang": "ta",
                    "text": "பச்சை விளக்கு வாகனத்தால் கடக்கப்படுகிறது"
                },
                {
                    "lang": "te",
                    "text": "గ్రీన్ లైట్ వాహనం దాటింది"
                },
                {
                    "lang": "ml",
                    "text": "വാഹനം മറികടന്ന് പച്ചപ്പി"
                },
                {
                    "lang": "gu",
                    "text": "લીલો પ્રકાશ વાહન દ્વારા ઓળંગી ગયો"
                },
                {
                    "lang": "bn",
                    "text": "যানবাহন দিয়ে সবুজ আলো অতিক্রম করেছে"
                },
                {
                    "lang": "ur",
                    "text": "گرین لائٹ گاڑی کے ذریعہ عبور کی گئی"
                },
                {
                    "lang": "kn",
                    "text": "ಹಸಿರು ಬೆಳಕು ವಾಹನದಿಂದ ದಾಟಿದೆ"
                }
            ]
        },
        {
            "message": "Changed Lane to left without indicating",
            "translations": [
                {
                    "lang": "hi",
                    "text": "बिना संकेत के बाईं ओर लेन को बदल दिया"
                },
                {
                    "lang": "ta",
                    "text": "சுட்டிக்காட்டாமல் பாதையை இடதுபுறமாக மாற்றியது"
                },
                {
                    "lang": "te",
                    "text": "సూచించకుండా లేన్‌ను ఎడమవైపు మార్చారు"
                },
                {
                    "lang": "ml",
                    "text": "സൂചിപ്പിക്കാതെ ഇടത്തേക്ക് മാറിയ പാത മാറ്റി"
                },
                {
                    "lang": "gu",
                    "text": "સૂચવ્યા વિના લેનને ડાબી બાજુ બદલી"
                },
                {
                    "lang": "bn",
                    "text": "ইঙ্গিত না করে বাম দিকে লেন পরিবর্তন"
                },
                {
                    "lang": "ur",
                    "text": "لین کو بغیر کسی اشارے کے بائیں میں تبدیل کردیا"
                },
                {
                    "lang": "kn",
                    "text": "ಸೂಚಿಸದೆ ಲೇನ್ ಅನ್ನು ಎಡಕ್ಕೆ ಬದಲಾಯಿಸಲಾಗಿದೆ"
                }
            ]
        },
        {
            "message": "Changed Lane to right without indicating",
            "translations": [
                {
                    "lang": "hi",
                    "text": "बिना संकेत के सही करने के लिए लेन को बदल दिया"
                },
                {
                    "lang": "ta",
                    "text": "சுட்டிக்காட்டாமல் பாதையை வலதுபுறமாக மாற்றியது"
                },
                {
                    "lang": "te",
                    "text": "సూచించకుండా లేన్ మార్చబడింది"
                },
                {
                    "lang": "ml",
                    "text": "പ്രേരിപ്പിക്കാതെ വലതുവശത്തേക്ക് മാറ്റി"
                },
                {
                    "lang": "gu",
                    "text": "સૂચવ્યા વિના લેનને જમણી તરફ બદલી"
                },
                {
                    "lang": "bn",
                    "text": "নির্দেশ না দিয়ে ডান থেকে ডানদিকে পরিবর্তন"
                },
                {
                    "lang": "ur",
                    "text": "لین کو دائیں میں تبدیل کیا بغیر اشارہ کیا"
                },
                {
                    "lang": "kn",
                    "text": "ಸೂಚಿಸದೆ ಲೇನ್ ಅನ್ನು ಬಲಕ್ಕೆ ಬದಲಾಯಿಸಲಾಗಿದೆ"
                }
            ]
        },
        {
            "message": "Collided with another vechicle",
            "translations": [
                {
                    "lang": "hi",
                    "text": "एक और vechicle से टकरा गया"
                },
                {
                    "lang": "ta",
                    "text": "மற்றொரு வெச்சிகலுடன் மோதியது"
                },
                {
                    "lang": "te",
                    "text": "మరొక వెచికల్‌తో ided ీకొట్టింది"
                },
                {
                    "lang": "ml",
                    "text": "മറ്റൊരു vickil- ൽ കൂട്ടിയിടിച്ചു"
                },
                {
                    "lang": "gu",
                    "text": "બીજા વેચિકલ સાથે ટકરાઈ"
                },
                {
                    "lang": "bn",
                    "text": "অন্য ভেচিকেলের সাথে সংঘর্ষ"
                },
                {
                    "lang": "ur",
                    "text": "ایک اور ویکیکل سے ٹکرا گیا"
                },
                {
                    "lang": "kn",
                    "text": "ಮತ್ತೊಂದು ವೆಕಿಕಲ್ಗೆ ಡಿಕ್ಕಿ ಹೊಡೆದಿದೆ"
                }
            ]
        },
        {
            "message": "Collided with Pedestrian",
            "translations": [
                {
                    "lang": "hi",
                    "text": "पैदल यात्री से टकरा गया"
                },
                {
                    "lang": "ta",
                    "text": "பாதசாரிகளுடன் மோதியது"
                },
                {
                    "lang": "te",
                    "text": "పాదచారులతో ided ీకొన్నారు"
                },
                {
                    "lang": "ml",
                    "text": "കാൽനടയാത്രക്കാരുമായി കൂട്ടിയിടിച്ചു"
                },
                {
                    "lang": "gu",
                    "text": "પદયાત્રીઓ સાથે ટકરાઈ"
                },
                {
                    "lang": "bn",
                    "text": "পথচারীদের সাথে সংঘর্ষ"
                },
                {
                    "lang": "ur",
                    "text": "پیدل چلنے والوں سے ٹکرا گیا"
                },
                {
                    "lang": "kn",
                    "text": "ಪಾದಚಾರಿಗಳಿಗೆ ಡಿಕ್ಕಿ ಹೊಡೆದಿದೆ"
                }
            ]
        },
        {
            "message": "Driving too close behind another vehicle: severity 3/3",
            "translations": [
                {
                    "lang": "hi",
                    "text": "ड्राइविंग एक और वाहन के पीछे बहुत करीब है: गंभीरता 3/3"
                },
                {
                    "lang": "ta",
                    "text": "மற்றொரு வாகனத்தின் பின்னால் மிக நெருக்கமாக வாகனம் ஓட்டுதல்: தீவிரம் 3/3"
                },
                {
                    "lang": "te",
                    "text": "మరొక వాహనం వెనుక చాలా దగ్గరగా డ్రైవింగ్: తీవ్రత 3/3"
                },
                {
                    "lang": "ml",
                    "text": "മറ്റൊരു വാഹനത്തിന് പിന്നിൽ ഡ്രൈവിംഗ്: തീവ്രത 3/3"
                },
                {
                    "lang": "gu",
                    "text": "બીજા વાહનની પાછળ ખૂબ નજીક ડ્રાઇવિંગ: ગંભીરતા 3/3"
                },
                {
                    "lang": "bn",
                    "text": "অন্য গাড়ির পিছনে খুব কাছাকাছি গাড়ি চালানো: তীব্রতা 3/3"
                },
                {
                    "lang": "ur",
                    "text": "دوسری گاڑی کے پیچھے بہت قریب ڈرائیونگ: شدت 3/3"
                },
                {
                    "lang": "kn",
                    "text": "ಮತ್ತೊಂದು ವಾಹನದ ಹಿಂದೆ ತುಂಬಾ ಹತ್ತಿರ ಚಾಲನೆ ಮಾಡುವುದು: ತೀವ್ರತೆ 3/3"
                }
            ]
        },
        {
